# Supabase project settings (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, never expose to the client/browser.
# Used to write daily_results/friendships from trusted API routes so
# scores and streaks can't be forged by a direct client insert.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute links (invite links, share links) from server code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
